rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn() && (request.auth.token.email == 'richkingsford@gmail.com' || request.auth.token.email == 'mckselph@gmail.com');
    }

    function isApproved() {
      return isAdmin() || (verified() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.verificationStatus == 'approved');
    }

    match /profiles/{userId} {
      // Account sign-in proves ownership here; email verification is not required to
      // finish the user's private profile or attach profile media.
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin() || (signedIn() && request.auth.uid == userId && request.resource.data.verificationStatus == 'pending');
      // Legacy profiles predate verificationStatus. Their first profile save establishes
      // the pending state; later saves must preserve the existing review status.
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId && ((resource.data.verificationStatus == null && request.resource.data.verificationStatus == 'pending') || request.resource.data.verificationStatus == resource.data.verificationStatus));
      allow delete: if isAdmin();
    }

    match /company-documents/{userId}/{documentId} {
      allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /proposals/{userId} {
      allow read, write: if isApproved() && (isAdmin() || request.auth.uid == userId);
    }
  }
}
